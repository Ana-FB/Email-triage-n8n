    {
      "parameters": {
        "jsCode": "const prevData = $('Limpiar y Preparar Texto').first().json;\n\n// Decodificar Buffer si la respuesta llegó como stream binario\nlet responseJson = $json;\nif (responseJson._readableState?.buffer || responseJson.type === 'Buffer') {\n  try {\n    let bytes = [];\n    if (responseJson._readableState?.buffer) {\n      for (const chunk of responseJson._readableState.buffer) {\n        if (chunk?.data) bytes = bytes.concat(Array.from(chunk.data));\n      }\n    } else if (responseJson.data) {\n      bytes = Array.from(responseJson.data);\n    }\n    if (bytes.length > 0) {\n      responseJson = JSON.parse(Buffer.from(bytes).toString('utf8'));\n    }\n  } catch(bufErr) { /* continuar con objeto original */ }\n}\n\nlet classification;\ntry {\n  const content = responseJson.content;\n  const rawText = Array.isArray(content) ? content[0].text : String(content || '');\n  const cleaned = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  classification = JSON.parse(cleaned);\n  if (!classification.categoria || !classification.urgencia || !classification.resumen) {\n    throw new Error('Campos faltantes');\n  }\n} catch(e) {\n  classification = {\n    categoria: 'consulta comercial',\n    urgencia: 'baja',\n    resumen: 'No se pudo clasificar automáticamente. Requiere revisión manual.'\n  };\n}\n\nreturn [{\n  json: {\n    sender: prevData.sender,\n    subject: prevData.subject,\n    date: prevData.date,\n    messageId: prevData.messageId,\n    bodyClean: prevData.bodyClean,\n    category: classification.categoria,\n    urgency: classification.urgencia,\n    summary: classification.resumen\n  }\n}];"
      },
