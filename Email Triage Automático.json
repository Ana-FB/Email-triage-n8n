      "id": "node-gmail-trigger-001",
      "name": "Gmail Trigger — Nuevo Correo",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        304
      ],
      "credentials": {
        "gmailOAuth2": {
