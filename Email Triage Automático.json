          }
        }
      },
      "id": "node-claude-classify-004",
      "name": "Clasificar con Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        784,
        304
      ],
      "credentials": {
